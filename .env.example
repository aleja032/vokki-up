# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Non-secret AI routing selection; provider credentials stay server-side.
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_MODEL=
GEMINI_API_KEY=

# 32-byte AES-256 key encoded as 64 hex characters or Base64; keep server-only.
AI_CREDENTIAL_ENCRYPTION_KEY=

# Server-only daily email reminders. Set the sender verification flag only after
# verifying this sender's domain in Resend. Never expose these values to clients.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_SENDER_DOMAIN_VERIFIED=false
